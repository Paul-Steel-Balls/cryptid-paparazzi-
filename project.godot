; Engine configuration file.
; Recovered from CryptidPaparazzi_2.apk (Godot 4.7.2).

config_version=5

[application]

config/name="Cryptid Paparazzi"
config/description="Cryptid Paparazzi: photograph cryptids for the tabloid. Meet the quota, don't get caught."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/game_state.gd"
Audio="*res://scripts/audio.gd"
Net="*res://scripts/net.gd"

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/vram_compression/import_s3tc_bptc=true
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=1
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=3
environment/defaults/default_clear_color=Color(0.1, 0.08, 0.28, 1)

[gui]

theme/custom_font="res://fonts/Oswald.ttf"
